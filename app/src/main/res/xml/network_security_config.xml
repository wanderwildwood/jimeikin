<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext http stays permitted, for two things only: a music server on a home network, which
    Navidrome serves over plain http out of the box (there is no certificate to be had for an
    address like 192.168.1.10), and radio streams, many of which are offered over http and
    nothing else. Android cannot scope cleartext to a range of addresses here (a
    domain-config names domains, not 192.168.0.0/16, and a station can be anywhere), so it is
    permitted app-wide and everything else the app does is https because it asks for https.

    What the app does about it: an address typed without a scheme is https; plain http is used
    only when typed, and the screen warns, in plain words, when that is a host that is not on a
    home network. The cost is real: anything fetched over http can be read by whoever else is on
    the path. The server screen and the privacy policy say the same.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
